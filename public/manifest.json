{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.1.0",
  "minimum_chrome_version": "132",
  "description": "__MSG_extDescription__",
  "default_locale": "ru",
  "permissions": ["cookies", "activeTab", "storage"],
  "optional_host_permissions": ["*://*/*"],
  "action": {
    "default_popup": "index.html",
    "default_title": "Cookiess",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "incognito": "split",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "__MSG_commandOpen__"
    }
  }
}
