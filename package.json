{
  "name": "cookiess",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:browser": "node scripts/browser-test.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "store:assets": "node scripts/store-assets.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/chrome": "^0.1.24",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.36.0",
    "globals": "^17.14.0",
    "playwright": "^1.56.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.7",
    "vitest": "^5.1.0"
  },
  "license": "MIT",
  "dependencies": {
    "tldts": "^7.5.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  }
}
