{
  "manifest_version": 3,
  "name": "Cookiess",
  "version": "1.0.1",
  "minimum_chrome_version": "132",
  "description": "Локальный менеджер cookies: просмотр, редактирование, импорт и экспорт текущего сайта.",
  "permissions": [
    "cookies",
    "activeTab",
    "storage"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "Cookiess",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "incognito": "split",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
